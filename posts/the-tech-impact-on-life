    <h1>The Tech Impact on Life</h1>
    
    <!-- Title Image -->
    <div style="margin:16px 0">
      <img src="https://raw.githubusercontent.com/axuarticletime/axuarticletime.github.io/main/img/technology-impact.jpg" 
           alt="The Tech Impact on Life" 
